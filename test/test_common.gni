# Union of the layers above: what a target that inlines the whole service
# stack compiles (userauthservice/coauthservice/remoteauthcontext fuzzers,
# iam_services_test). Dummy mocks and per-target sources are appended by the
# consuming target.
userauth_test_services_sources =
    userauth_test_services_base_sources +
    userauth_test_services_context_sources +
    userauth_test_services_core_sources + userauth_test_services_ipc_sources +
    userauth_test_services_load_mode_default_sources +
    userauth_test_services_helper_sources

userauth_test_fuzz_cflags = [
  "-g",
  "-O0",
  "-Wno-unused-variable",
  "-fno-omit-frame-pointer",
  "-Dprivate=public",
  "-Dprotected=public",
]

