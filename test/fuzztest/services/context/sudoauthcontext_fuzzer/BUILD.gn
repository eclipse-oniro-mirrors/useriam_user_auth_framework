import("//build/ohos.gni")
import("//build/test.gni")
import("../../../../test_common.gni")

ohos_fuzztest("SudoAuthContextFuzzTest") {
  branch_protector_ret = "pac_ret"
  module_out_path = "user_auth_framework/user_auth/concurrent"
  fuzz_config_file = "../sudoauthcontext_fuzzer"

  cflags = userauth_test_fuzz_cflags + [ "-DIAM_TEST_ENABLE" ]

  include_dirs = [
    "../../../dummy",
    "../../../../../services/base/inc",
    "../../../../../services/core/inc",
    "../../../../../services/core/src",
    "../../../../../services/context/inc",
    "../../../../../services/context/src",
    "../../../../../services/ipc/inc",
    "../../../../../services/remote_connect/inc",
    "../../../../../services/remote_connect/default/inc",
    "../../../../../frameworks/native/client/inc",
    "../../../../../frameworks/native/ipc/inc",
    "../../../../../frameworks/native/ipc/common_defines",
    "../../../../../frameworks/common/inc",
    "../../../../../interfaces/inner_api",
    "../../../../../common/utils",
    "../../../../../common/logs",
    "../../../../../frameworks/native/common/dfx/inc",
    "../../../../../common/test",
    "../../../../../services/load_mode/inc",
  ]

  sources = userauth_test_services_context_sources +
            userauth_test_services_ipc_sources +
            userauth_test_services_load_mode_default_sources +
            userauth_test_services_helper_sources +
            [
              "../../../dummy/mock_application_state_observer_stub.cpp",
              "../../../dummy/mock_ipc_common.cpp",
              "sudo_auth_context_fuzzer.cpp",
            ]

  deps = userauth_test_services_context_fuzz_deps

  configs =
      [ "../../../../../frameworks/native/ipc:userauth_client_ipc_config" ]

  remove_configs = [ "//build/config/compiler:no_exceptions" ]

  external_deps = [
                    "ability_base:base",
                    "ability_base:want",
                    "ability_base:zuri",
                    "ability_runtime:ability_connect_callback_stub",
                    "ability_runtime:ability_context_native",
                    "ability_runtime:abilitykit_native",
                    "ability_runtime:extension_manager",
                    "access_token:libaccesstoken_sdk",
                    "access_token:libtoken_setproc",
                    "access_token:libtokenid_sdk",
                    "c_utils:utils",
                    "config_policy:configpolicy_util",
                    "drivers_interface_user_auth:libuser_auth_proxy_4.0",
                    "drivers_interface_user_auth:libuser_auth_proxy_4.1",
                    "eventhandler:libeventhandler",
                    "hdf_core:libhdf_utils",
                    "hdf_core:libhdi",
                    "hicollie:libhicollie",
                    "hilog:libhilog",
                    "hitrace:hitrace_meter",
                    "init:libbeget_proxy",
                    "init:libbegetutil",
                    "ipc:ipc_core",
                    "ipc:ipc_single",
                    "libuv:uv",
                    "napi:ace_napi",
                    "node:node_header_notice",
                    "safwk:system_ability_fwk",
                    "samgr:samgr_proxy",
                  ] + userauth_test_screenlock_external_deps +
                  userauth_test_os_account_external_deps

  defines = userauth_test_screenlock_defines
  cflags_cc = userauth_test_os_account_cflags_cc

  subsystem_name = "useriam"
  part_name = "user_auth_framework"
}
